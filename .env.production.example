# Copy to .env.production on the Lightsail server (never commit real file).
# Generate secrets: powershell scripts/generate-secrets.ps1
# Or copy from staging.env via: scripts/prepare-production-env.ps1

APP_HOSTNAME=app.patientvault.care
ACME_EMAIL=you@yourpractice.com

# IMPORTANT: URL-encode special password characters (# ? @ : /) or use discrete vars below.
# Broken example: ...://pvadmin:pass#word@host...  (# truncates the URL → login/DB 503)
DATABASE_URL=postgresql://pvadmin:PASSWORD@patient-vault-db.cj9hnwn91exe.us-east-1.rds.amazonaws.com:5432/patientvault?sslmode=require
# Preferred (safe with any password characters):
# DATABASE_HOST=patient-vault-db.cj9hnwn91exe.us-east-1.rds.amazonaws.com
# DATABASE_USER=pvadmin
# DATABASE_PASSWORD=PASSWORD
# DATABASE_NAME=patientvault
# DATABASE_SSLMODE=require

JWT_SECRET=
ENCRYPTION_KEY=

SESSION_TIMEOUT_MINUTES=15

NODE_ENV=production
APP_ENV=production

STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/storage

AWS_REGION=us-east-1
# After S3 bucket created:
# STORAGE_TYPE=s3
# AWS_S3_BUCKET=patient-vault-docs-YOUR-SUFFIX

FAX_PROVIDER=mock
OPENAI_API_KEY=

NEXT_PUBLIC_APP_NAME=Patient Vault
NEXT_PUBLIC_CLINIC_NAME=Modern Medicine
