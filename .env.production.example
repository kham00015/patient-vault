# Copy to .env.production on the Lightsail server (never commit real file).
# Generate secrets: powershell scripts/generate-secrets.ps1
# Or copy from staging.env via: scripts/prepare-production-env.ps1

APP_HOSTNAME=app.patientvault.care
ACME_EMAIL=you@yourpractice.com

DATABASE_URL=postgresql://pvadmin:PASSWORD@patient-vault-db.cj9hnwn91exe.us-east-1.rds.amazonaws.com:5432/patientvault?sslmode=require

JWT_SECRET=
ENCRYPTION_KEY=

SESSION_TIMEOUT_MINUTES=5

NODE_ENV=production
APP_ENV=production

STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/storage

AWS_REGION=us-east-1
# After S3 bucket created in AWS Console:
# STORAGE_TYPE=s3
# AWS_S3_BUCKET=patient-vault-docs-aloha-885362002526
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Then run: .\scripts\setup-s3-production.ps1
# Then run: .\scripts\apply-production-hardening.ps1

FAX_PROVIDER=mock

# AWS Bedrock Ask AI (covered by AWS BAA) — enable Claude in Bedrock model access
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_REGION=us-east-1
# AWS_USE_INSTANCE_ROLE=1
# BEDROCK_DISABLED=1

# AssemblyAI — AI Listen transcription (BAA)
ASSEMBLYAI_API_KEY=
# ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
# ASSEMBLYAI_DISABLED=1

# Legacy — do not use OpenAI for PHI
# OPENAI_API_KEY=

# Visit recorder (/visit-recorder) — TEMPORARY password-free testing ONLY
# Never leave enabled for real clinic use without auth.
# VISIT_RECORDER_TEST_MODE=1
# VISIT_RECORDER_TEST_KEY=choose-a-long-random-string
# VISIT_RECORDER_TEST_USER_EMAIL=admin@yourpractice.com

NEXT_PUBLIC_APP_NAME="AICLIN EMR"
NEXT_PUBLIC_CLINIC_NAME=Modern Medicine
