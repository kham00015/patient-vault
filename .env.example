# Database — local dev (Docker): docker compose up postgres -d
# DATABASE_URL="postgresql://patientvault:change_me_in_production@localhost:5432/patientvault"

DATABASE_URL="postgresql://patientvault:change_me_in_production@localhost:5432/patientvault"

# Auth — run: powershell scripts/generate-secrets.ps1
JWT_SECRET="change-me-to-a-long-random-secret-min-32-chars"
ENCRYPTION_KEY="change-me-to-a-32-byte-base64-key"

SESSION_TIMEOUT_MINUTES=30

# OpenAI — deprecated for PHI; use Bedrock (BAA)
# OPENAI_API_KEY=""

# AWS Bedrock Ask AI (HIPAA BAA) — enable Claude model access in Bedrock console
AWS_REGION="us-east-1"
# BEDROCK_REGION="us-east-1"   # defaults to AWS_REGION
BEDROCK_MODEL_ID="us.anthropic.claude-sonnet-4-5-20250929-v1:0"
# BEDROCK_DISABLED="1"        # emergency kill switch
# AssemblyAI — AI Listen transcription (BAA under Legal)
ASSEMBLYAI_API_KEY=""
# ASSEMBLYAI_BASE_URL="https://api.assemblyai.com"  # optional; EU: https://api.eu.assemblyai.com
# ASSEMBLYAI_DISABLED="1"     # emergency kill switch
# TRANSCRIBE_REGION="us-east-1"  # legacy AWS Transcribe Medical (unused by Listen/Recorder)
# TRANSCRIBE_DISABLED="1"
# AWS_USE_INSTANCE_ROLE="1"   # production Lightsail/EC2 IAM role (no access keys)

# Fax — mock (dev) | faxplus (production with BAA)
FAX_PROVIDER="mock"
# FAXPLUS_API_KEY="your-fax-plus-personal-access-token"
# FAXPLUS_FROM_NUMBER="+15551234567"
# FAXPLUS_API_BASE="https://restapi.fax.plus/v3"
# FAX_FROM_NAME="Modern Medicine"

# Storage: local | s3
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="./storage"

# AWS S3 (production — after BAA signed)
# AWS_S3_BUCKET=""
# AWS_KMS_KEY_ID=""
# AWS_ACCESS_KEY_ID=""      # or use IAM role on instance
# AWS_SECRET_ACCESS_KEY=""

# Local Windows scanner bridge (Scan button). Default: http://127.0.0.1:18991
# Start with: npm run scanner-bridge
# NEXT_PUBLIC_SCANNER_BRIDGE_URL="http://127.0.0.1:18991"

# Visit recorder (/visit-recorder) — TEMPORARY password-free testing only
# VISIT_RECORDER_TEST_MODE=1
# Optional shared key: require ?key=... on the page/API
# VISIT_RECORDER_TEST_KEY=choose-a-long-random-string
# Optional: attribute test actions to a specific user email
# VISIT_RECORDER_TEST_USER_EMAIL=admin@example.com

NEXT_PUBLIC_CLINIC_NAME="Modern Medicine"
NEXT_PUBLIC_APP_NAME="AICLIN EMR"
NODE_ENV="development"
